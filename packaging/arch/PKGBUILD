# Maintainer: DeadlySinFredo
# Arch/CachyOS package built from git. Build + install: makepkg -si
pkgname=tinypaws-git
pkgver=r0
pkgrel=1
pkgdesc='Pixel desktop pet & stream companion (cat, dog, fox, rabbit, dragon, bird)'
arch=('any')
url='https://github.com/DeadlySinFredo/TinyPaws'
license=('MIT')
depends=('python' 'pyside6')
optdepends=('libsecret: keep the Twitch login in the system keyring'
            'xorg-xwayland: always-on-top pet on KDE Wayland')
makedepends=('git')
provides=('tinypaws')
conflicts=('tinypaws')
# private repo / local checkout: TINYPAWS_REPO=file:///path/to/TinyPaws makepkg -si
source=("tinypaws::git+${TINYPAWS_REPO:-${url}.git}#branch=${TINYPAWS_BRANCH:-main}")
sha256sums=('SKIP')

pkgver() {
  cd tinypaws
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

check() {
  cd tinypaws
  QT_QPA_PLATFORM=offscreen XDG_CONFIG_HOME="$srcdir/cfg" python -m unittest discover -s tests -t .
}

package() {
  cd tinypaws
  install -d "$pkgdir/usr/lib/tinypaws"
  tar --exclude=__pycache__ -cf - tinypaws | tar -xf - -C "$pkgdir/usr/lib/tinypaws"
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/tinypaws" <<'SH'
#!/bin/sh
PYTHONPATH=/usr/lib/tinypaws exec python3 -m tinypaws "$@"
SH
  install -Dm644 packaging/tinypaws.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/tinypaws.png"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/tinypaws.desktop" <<'DESK'
[Desktop Entry]
Type=Application
Name=TinyPaws
Comment=Pixel desktop pet
Exec=tinypaws
Icon=tinypaws
Categories=Game;Amusement;
DESK
  install -Dm644 docs/PET_PACKS.md "$pkgdir/usr/share/doc/tinypaws/PET_PACKS.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
